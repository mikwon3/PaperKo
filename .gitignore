# ─── Bundled runtimes & build outputs (regenerated by scripts; too large for git) ───
desktop/paperko/bin/
desktop/paperko/resources/python/
desktop/paperko/resources/llama/
desktop/paperko/paperko_app_bundled
desktop/paperko/paperko
desktop/paperko/build/darwin/
**/node_modules/
**/dist/
# Wails bindings are generated by `wails3 generate bindings` on every build
# (dev + build-macos-dmg.sh + build-windows.ps1); don't track the churn.
desktop/paperko/frontend/bindings/
engine-py/build/
engine-py/dist/
*.egg-info/

# ─── Python ───
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# ─── Installers / binaries / build artifacts ───
*.dmg
*.exe
*.app/
*.msi
*.pkg

# ─── Generated / test outputs ───
# (the bundled converter skeleton engine-py/.../hwpx/assets/default_skeleton.hwpx
#  is required package-data and is NOT ignored — no blanket *.hwpx rule)
webapp/data/
webapp/static/previews/

# ─── Local config, secrets, logs ───
settings.json
*.local.json
.env
.env.*
*.log

# ─── OS / editor cruft ───
.DS_Store
._*
.idea/
.vscode/
*.swp
